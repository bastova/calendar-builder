# Stable public origin, with no path; set before building for deployment.
# SITE_URL=https://calendar.example.com
# Optional Google Search Console ownership verification token.
# GOOGLE_SITE_VERIFICATION=

# Optional GA4 web measurement ID. Leave unset to disable analytics.
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# GitHub Pages build only (the workflow supplies these).
# STATIC_EXPORT=true
# NEXT_PUBLIC_BASE_PATH=/calendar-builder
